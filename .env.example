# Copie para um arquivo `.env` local (NUNCA commite o `.env` com valores reais).
# O agente e o relay carregam este `.env` na inicialização; %USERPROFILE% é
# expandido; chave de PROVEDOR salva pelo app vence variável antiga do sistema
# (demais variáveis: sistema manda). Alternativa: setx + reabrir, ou salvar
# direto no app (menu > Provedores de IA; V5.4.3).
# No Render, configure estas mesmas chaves em Environment > Secret Files / Env Vars.
# Gere hash e segredos com os comandos do README. Nenhum valor real deve estar aqui.

JULIA_ENV=development
JULIA_USERNAME=
JULIA_PASSWORD_HASH=
JULIA_AGENT_TOKEN=
JULIA_SESSION_SECRET=

# Somente no PC (nunca no Render):
JULIA_RELAY_URL=http://127.0.0.1:8000
JULIA_SQLITE_PATH=%USERPROFILE%\\Documents\\JULIAMobile\\memory.sqlite3
# Interface do relay: 127.0.0.1 (só neste PC) ou 0.0.0.0 (modo direto/Tailscale).
JULIA_HOST=127.0.0.1

# IA via Hermes Subscription Proxy local (Opção A — inferência):
HERMES_PROXY_URL=http://127.0.0.1:8645/v1
JULIA_AI_MODEL=poolside/laguna-s-2.1:free
# Provedores diretos (Opcao B): chaves SOMENTE no PC (nunca no Render; o app
# só transporta ao salvar, não guarda — V5.4.3). Com chave, o modelo
# "provedor/modelo" aparece no seletor. Sem chave, o provedor aparece
# desabilitado; chave recusada (401) também, com aviso.
# Alternativa sem editar este arquivo: menu > Provedores de IA no app.
# Teste de verdade: python tools\ia_smoke.py
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#DEEPSEEK_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#OPENROUTER_API_KEY=
# Alternativos explícitos (vírgula, máx 4) tentados em ordem se o preferencial
# falhar; vazio = sem fallback. Ex.: JULIA_AI_FALLBACKS=modelo-b,modelo-c
JULIA_AI_FALLBACKS=
# Instruções adicionais; vazio usa o padrão. Identidade fixa em assistant_identity.py.
JULIA_SYSTEM_PROMPT=
JULIA_AI_CONTEXT=20
JULIA_AI_MAX_TOKENS=2000

# Pesquisa acadêmica opcional (OpenAlex + Crossref; sem chave obrigatória).
JULIA_ACADEMIC_RESEARCH=0
# Contato opcional para o User-Agent e o parâmetro mailto do Crossref.
JULIA_RESEARCH_MAILTO=

# Redação e revisão final pelo modelo configurado (até 2 chamadas; 0 = extrativa).
VEXX_RESEARCH_SYNTHESIS=1
# Segunda fonte de busca opcional (instância SearXNG própria; sem ela o
# provedor responde indisponível e o DDG continua como primário).
#JULIA_SEARXNG_URL=http://127.0.0.1:8888

# Controle remoto (aba Meu PC). SEM isso, o celular só vê a tela.
# Com 1, toques/teclas do celular são executados no PC (tudo vai para o log).
JULIA_REMOTE=0


# Clima: somente no PC Agent. Chave nunca enviada ao frontend/relay.
VISUAL_CROSSING_API_KEY=
# Teto local por chave / janela móvel de 24h (máximo 1000; não habilita cobrança).
VISUAL_CROSSING_DAILY_LIMIT=1000
# Metadados privados de quota/cache. Padrão: junto ao SQLite do PC.
#VISUAL_CROSSING_USAGE_PATH=%USERPROFILE%\Documents\JULIAMobile\weather-usage.sqlite3
# Geocodificação internacional opcional Photon/OSM, sem autocomplete, cache 24h.
# Serviço público sem SLA; desative com 0. Brasil prioriza cadastro IBGE.
VEXX_PHOTON_ENABLED=1
