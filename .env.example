# Copie para um arquivo `.env` local (NUNCA commite o `.env` com valores reais).
# No Render, configure estas mesmas chaves em Environment > Secret Files / Env Vars.
# Gere hash e segredos com os comandos do README. Nenhum valor real deve estar aqui.

FAJULTO_ENV=development
FAJULTO_USERNAME=
FAJULTO_PASSWORD_HASH=
FAJULTO_AGENT_TOKEN=
FAJULTO_SESSION_SECRET=

# Somente no PC (nunca no Render):
FAJULTO_RELAY_URL=http://127.0.0.1:8000
FAJULTO_SQLITE_PATH=%USERPROFILE%\\Documents\\FAJULTOMobile\\memory.sqlite3
# Interface do relay: 127.0.0.1 (só neste PC) ou 0.0.0.0 (modo direto/Tailscale).
FAJULTO_HOST=127.0.0.1

# IA via Hermes Subscription Proxy local (Opção A — inferência):
HERMES_PROXY_URL=http://127.0.0.1:8645/v1
FAJULTO_AI_MODEL=poolside/laguna-s-2.1:free
FAJULTO_SYSTEM_PROMPT=
FAJULTO_AI_CONTEXT=20
FAJULTO_AI_MAX_TOKENS=2000

# Controle remoto (aba Meu PC). SEM isso, o celular só vê a tela.
# Com 1, toques/teclas do celular são executados no PC (tudo vai para o log).
FAJULTO_REMOTE=0
