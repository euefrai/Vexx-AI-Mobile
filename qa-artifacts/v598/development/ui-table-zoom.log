```js
await (async page => {await page.evaluate(()=>document.body.style.zoom='1');await page.getByLabel('Pesquisa').selectOption('comparison');await page.setViewportSize({width:320,height:800});await page.waitForFunction(()=>document.querySelector('.jdui-scrollx'));const table=await page.evaluate(()=>{const e=document.querySelector('.jdui-scrollx');e.scrollLeft=e.scrollWidth;return {width:innerWidth,root:document.documentElement.scrollWidth,client:e.clientWidth,scroll:e.scrollWidth,left:e.scrollLeft};});if(table.root>table.width||table.left<=0)throw Error('table mobile scrolling failed');await page.evaluate(data=>window.v598Table=data,table);await page.getByLabel('Pesquisa').selectOption('images');await page.waitForFunction(()=>document.getElementById('status').textContent.endsWith('images'));await page.getByRole('button',{name:/Ampliar:/}).first().click();await page.waitForFunction(()=>{const i=document.querySelector('dialog img');return i&&i.complete&&i.naturalWidth>0;},{timeout:15000});await page.keyboard.press('Escape');if(await page.getByRole('dialog').count())throw Error('dialog remains open');})(page);
